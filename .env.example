# Copy to .env and fill in. NEVER commit .env.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Model IDs are configuration, not constants.
# Verify against current provider docs before any large run.
PROVIDER_A_MODEL=
PROVIDER_B_MODEL=

# USD per million tokens — check current pricing pages.
PROVIDER_A_INPUT_PER_MTOK=
PROVIDER_A_OUTPUT_PER_MTOK=
PROVIDER_B_INPUT_PER_MTOK=
PROVIDER_B_OUTPUT_PER_MTOK=

# Safety rail: abort a run whose projected cost exceeds this.
MAX_RUN_COST_USD=25
